# Copy to `.env.local`. No secrets belong here: everything prefixed VITE_ is
# compiled into the browser bundle.

# Which data source the domain services resolve: "mock" (default) or "http".
VITE_DATA_SOURCE=mock

# Only used when VITE_DATA_SOURCE=http. Every adapter path starts "/v1/...",
# and the live backend serves those under "/api/v1/...", so this MUST include
# the "/api" suffix — e.g. https://api.jofit.example/api, not the bare host.
VITE_API_BASE_URL=

# Public storefront, linked to from the admin header.
VITE_STOREFRONT_URL=http://localhost:3001

# Artificial delay in the mock adapters so loading states are reachable in dev.
VITE_MOCK_LATENCY_MS=0
